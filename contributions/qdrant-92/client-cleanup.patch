+++ b/tests/engine/clients/test_search_client_cleanup.py
@@ -0,0 +1,91 @@
+from unittest.mock import Mock
+
+import pytest
+
+from engine.base_client.client import BaseClient
+from engine.clients.elasticsearch.configure import ElasticConfigurator
+from engine.clients.elasticsearch.search import ElasticSearcher
+from engine.clients.elasticsearch.upload import ElasticUploader
+from engine.clients.opensearch.configure import OpenSearchConfigurator
+from engine.clients.opensearch.search import OpenSearchSearcher
+from engine.clients.opensearch.upload import OpenSearchUploader
+
+CLIENT_CLASSES = [
+    ElasticConfigurator,
+    ElasticSearcher,
+    ElasticUploader,
+    OpenSearchConfigurator,
+    OpenSearchSearcher,
+    OpenSearchUploader,
+]
+
+
+@pytest.fixture(params=CLIENT_CLASSES)
+def client_owner(request, monkeypatch):
+    client_class = request.param
+    if issubclass(client_class, (ElasticConfigurator, OpenSearchConfigurator)):
+        owner = client_class.__new__(client_class)
+        owner.client = None
+    else:
+        owner = client_class
+        monkeypatch.setattr(owner, "client", None)
+    return owner
+
+
+def test_delete_client_closes_once_and_clears_reference(client_owner):
+    client = Mock()
+    client_owner.client = client
+
+    client_owner.delete_client()
+    client_owner.delete_client()
+
+    client.close.assert_called_once_with()
+    assert client_owner.client is None
+
+
+def test_delete_client_before_initialization(client_owner):
+    client_owner.delete_client()
+    assert client_owner.client is None
+
+
+def test_delete_client_can_close_a_replacement_client(client_owner):
+    first_client = Mock()
+    second_client = Mock()
+    client_owner.client = first_client
+    client_owner.delete_client()
+    client_owner.client = second_client
+    client_owner.delete_client()
+
+    first_client.close.assert_called_once_with()
+    second_client.close.assert_called_once_with()
+    assert client_owner.client is None
+
+
+@pytest.mark.parametrize(
+    "configurator_class,uploader_class,searcher_class",
+    [
+        (ElasticConfigurator, ElasticUploader, ElasticSearcher),
+        (OpenSearchConfigurator, OpenSearchUploader, OpenSearchSearcher),
+    ],
+)
+def test_base_client_cleanup_closes_all_engine_connections(
+    configurator_class, uploader_class, searcher_class, monkeypatch
+):
+    configurator = configurator_class.__new__(configurator_class)
+    connections = [Mock(), Mock(), Mock()]
+    configurator.client = connections[0]
+    monkeypatch.setattr(uploader_class, "client", connections[1])
+    monkeypatch.setattr(searcher_class, "client", connections[2])
+    client = BaseClient(
+        name="cleanup-test",
+        engine="test",
+        configurator=configurator,
+        uploader=uploader_class("localhost", {}, {}),
+        searchers=[searcher_class("localhost", {}, {})],
+    )
+
+    client.delete_client()
+    client.delete_client()
+
+    for connection in connections:
+        connection.close.assert_called_once_with()
